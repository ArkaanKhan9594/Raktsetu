# -----------------------------------------------------------------------------
# RaktSetu Flutter Mobile Application Production Environment
# -----------------------------------------------------------------------------

# Backend Selector: 'firebase' or 'rest'
BACKEND_TYPE=firebase

# Production API Endpoint (Used when BACKEND_TYPE=rest)
# Must be HTTPS with valid SSL certificate. Localhost is strictly prohibited.
API_URL=https://api.raktsetu.org

# Application Versioning
APP_VERSION=1.0.0
BUILD_NUMBER=1
