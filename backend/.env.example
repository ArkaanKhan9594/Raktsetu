# -----------------------------------------------------------------------------
# RaktSetu Production Backend Environment Configuration
# Copy this file to .env and provide your production variables.
# NEVER commit the real .env file with production credentials to source control.
# -----------------------------------------------------------------------------

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (PostgreSQL - compatible with Supabase, Neon, AWS RDS, Railway)
DATABASE_URL=postgresql://postgres:YOUR_STRONG_PASSWORD@your-db-host.supabase.co:5432/postgres

# Security & Secrets
JWT_SECRET=YOUR_64_CHAR_RANDOM_SECRET_KEY_FOR_JWT_SIGNING
CORS_ORIGIN=*

# SMS Gateway for Production Phone Auth (Optional: Twilio, MSG91, or Fast2SMS)
SMS_PROVIDER=mock
SMS_API_KEY=YOUR_SMS_API_KEY
SMS_SENDER_ID=RAKTST
